@using System.Text.Json
@using WebBanSach.Models.Entities
@{
    var book = ViewData["Book"] as ThongTinSach;
    var author = ViewData["Author"] as TacGia;
    var reviews = ViewData["Reviews"] as List<DanhGia> ?? new List<DanhGia>();

    // Lấy mã video từ link YouTube (watch?v=ID | youtu.be/ID | embed/ID)
    string? youtubeId = null;
    if (Uri.TryCreate(book?.LinkYoutube, UriKind.Absolute, out var ytUri))
    {
        youtubeId = System.Web.HttpUtility.ParseQueryString(ytUri.Query)["v"]
                    ?? ytUri.Segments.LastOrDefault()?.Trim('/');
    }

    // Dữ liệu từ DB, js/data.js sẽ ghi đè lên dữ liệu mẫu (xem cuối data.js)
    var serverData = new
    {
        bookUid = book?.Uid,
        price = book?.GiaBan,
        youtubeId,
        reviews = reviews.Select(r => new { name = r.HoTen, rating = r.SoSao, content = r.NoiDungDanhGia, avatar = r.AnhDaiDien })
    };
}
<script>
    window.NGK = window.NGK || {};
    window.NGK.server = @Html.Raw(JsonSerializer.Serialize(serverData));
</script>

<main id="main">

    <!-- ===================== HERO ===================== -->
    <section id="gioi-thieu" class="hero relative overflow-hidden text-ivory" aria-labelledby="hero-title">
        <!-- Chòm sao trang trí -->
        <svg class="hero-deco left-[4%] top-10 hidden w-56 opacity-60 md:block" viewBox="0 0 220 140" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-opacity=".35" stroke-width="1">
                <polyline points="12,108 58,72 96,86 140,38 196,52" />
                <line x1="96" y1="86" x2="118" y2="124" />
            </g>
            <g fill="currentColor">
                <circle cx="12" cy="108" r="2" /><circle cx="58" cy="72" r="2.4" /><circle cx="96" cy="86" r="1.8" />
                <circle cx="118" cy="124" r="1.6" /><circle cx="196" cy="52" r="2" />
                <path class="twinkle" d="M140 26 L142.5 35.5 L152 38 L142.5 40.5 L140 50 L137.5 40.5 L128 38 L137.5 35.5 Z" />
            </g>
        </svg>
        <svg class="hero-deco right-[6%] top-8 hidden w-24 lg:block" viewBox="0 0 100 100" aria-hidden="true">
            <path class="twinkle" style="animation-delay:1.5s" fill="currentColor" fill-opacity=".7" d="M50 20 L54 46 L80 50 L54 54 L50 80 L46 54 L20 50 L46 46 Z" />
        </svg>
        <!-- Đồi cát: lớp sóng cuối cùng tô màu nền section kế tiếp (ivory) để đường sóng chính là ranh giới 2 section -->
        <svg class="hero-deco inset-x-0 -bottom-px h-20 w-full md:h-28 lg:h-32" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
            <!-- đồi cát phía sau (tím đậm) -->
            <path d="M0 70 C200 30 420 100 700 66 C960 36 1180 90 1440 52 L1440 160 L0 160 Z" fill="#1A0D33" fill-opacity=".45" />
            <path d="M0 70 C200 30 420 100 700 66 C960 36 1180 90 1440 52" fill="none" stroke="#C98754" stroke-opacity=".3" stroke-width="1" vector-effect="non-scaling-stroke" />
            <!-- đồi cát phía trước = nền section Tác giả -->
            <path d="M0 118 C240 78 460 150 760 112 C1020 80 1220 128 1440 96 L1440 161 L0 161 Z" fill="#F7F2E9" />
            <path d="M0 118 C240 78 460 150 760 112 C1020 80 1220 128 1440 96" fill="none" stroke="#D8AD61" stroke-opacity=".7" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="container-site relative grid items-center gap-6 pb-24 pt-12 md:pb-32 lg:grid-cols-[1.1fr_.9fr] lg:gap-12 lg:pt-20">
            <div class="text-center lg:text-left">
                <p class="eyebrow reveal">Tác phẩm của Paulo Coelho</p>
                <h1 id="hero-title" class="hero-title reveal mt-4" style="--delay:.08s">
                    @(book?.TieuDeChinh)<span class="sr-only"> – @(author?.HoTenTacGia)</span>
                </h1>
                <!-- TieuDePhu là HTML gồm các thẻ <p>: p đầu là câu dẫn, p sau là mô tả -->
                <div class="reveal mx-auto mt-5 max-w-[52ch] lg:mx-0
                            [&>p:first-child]:max-w-[36ch] [&>p:first-child]:text-lg [&>p:first-child]:font-medium [&>p:first-child]:leading-relaxed [&>p:first-child]:text-champagne md:[&>p:first-child]:text-xl
                            [&>p+p]:mt-4 [&>p+p]:text-[15px] [&>p+p]:text-ivory/75 md:[&>p+p]:text-base" style="--delay:.16s">
                    @Html.Raw(book?.TieuDePhu)
                </div>

                <div class="reveal mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center lg:justify-start" style="--delay:.32s">
                    <button type="button" id="hero-cta" data-open-order class="btn btn-primary btn-lg">
                        Mua sách ngay <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                    <a href="#doc-thu" class="btn btn-outline-gold btn-lg">
                        <i class="fa-solid fa-book-open" aria-hidden="true"></i> Đọc thử
                    </a>
                </div>

                <ul class="hero-meta reveal mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-ivory/80 lg:justify-start" style="--delay:.4s">
                    <li><i class="fa-solid fa-tag" aria-hidden="true"></i> Giá bán: <strong class="text-champagne" data-price>—</strong></li>
                    <li><i class="fa-solid fa-hand-holding-dollar" aria-hidden="true"></i> Thanh toán khi nhận hàng</li>
                    <li><i class="fa-solid fa-building-columns" aria-hidden="true"></i> Hoặc chuyển khoản</li>
                </ul>
            </div>

            <div class="book-stage reveal" style="--delay:.2s">
                <div class="book-glow" aria-hidden="true"></div>
                <div class="book-float">
                    <div class="book-3d">
                        <img src="@(book?.AnhSach)" width="720" height="1052" fetchpriority="high"
                             alt="Bìa sách Nhà Giả Kim của Paulo Coelho, bản dịch Lê Chu Cầu – nền xanh đêm với họa tiết kim tự tháp, sa mạc và bầu trời sao màu vàng">
                    </div>
                </div>
                <div class="book-shadow" aria-hidden="true"></div>
            </div>
        </div>
    </section>

    <!-- ===================== TÁC GIẢ ===================== -->
    <section id="tac-gia" class="section bg-ivory" aria-label="Về tác giả">
        <div class="container-site grid items-center gap-14 lg:grid-cols-[5fr_7fr] lg:gap-20">
            <figure class="reveal mx-auto w-full max-w-[400px] lg:max-w-none">
                <div class="author-frame">
                    <!-- TODO: kiểm tra giấy phép ảnh; nên tải về images/ (WebP, độ phân giải cao) thay vì dùng link ngoài -->
                    <img src="@(author?.AnhDaiDien)"
                         width="480" height="600" loading="lazy" decoding="async" referrerpolicy="no-referrer"
                         class="aspect-[4/5] object-cover object-top"
                         onerror="this.onerror=null;this.src='images/author-portrait.svg'"
                         alt="Chân dung nhà văn @(author?.HoTenTacGia)">
                </div>
                <figcaption class="mt-5 text-center text-sm text-ink/70">@(author?.HoTenTacGia) – nhà văn Brazil</figcaption>
            </figure>

            <div>
                <p class="eyebrow eyebrow--light reveal">Về tác giả</p>

                <!-- GioiThieu là HTML (tiêu đề h2, các đoạn p, ul mốc thời gian, blockquote) -->
                <div class="author-content reveal mt-3" style="--delay:.08s">
                    @Html.Raw(author?.GioiThieu)
                </div>

                <div class="reveal mt-10" style="--delay:.36s">
                    <button type="button" data-open-order class="btn btn-royal">
                        Sở hữu Nhà Giả Kim <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== TRUYỀN THÔNG & VIDEO ===================== -->
    <section id="truyen-thong" class="section media-section relative overflow-hidden text-ivory" aria-labelledby="media-title">
        <svg class="hero-deco -right-10 top-10 hidden w-72 opacity-40 lg:block" viewBox="0 0 200 200" fill="none" aria-hidden="true">
            <circle cx="100" cy="100" r="44" stroke="currentColor" stroke-width="1" />
            <circle cx="100" cy="100" r="70" stroke="currentColor" stroke-opacity=".5" stroke-width="1" stroke-dasharray="2 6" />
            <g stroke="currentColor" stroke-width="1" stroke-linecap="round">
                <line x1="100" y1="20" x2="100" y2="44" /><line x1="100" y1="156" x2="100" y2="180" />
                <line x1="20" y1="100" x2="44" y2="100" /><line x1="156" y1="100" x2="180" y2="100" />
                <line x1="43" y1="43" x2="60" y2="60" /><line x1="140" y1="140" x2="157" y2="157" />
                <line x1="157" y1="43" x2="140" y2="60" /><line x1="60" y1="140" x2="43" y2="157" />
            </g>
        </svg>

        <div class="container-site relative">
            <header class="mx-auto max-w-3xl text-center">
                <p class="eyebrow eyebrow--center reveal">Truyền thông &amp; Video</p>
                <h2 id="media-title" class="section-title reveal mt-3 text-champagne" data-media-title style="--delay:.08s">
                    Nhà Giả Kim qua góc nhìn truyền thông
                </h2>
                <p class="section-lead reveal mx-auto mt-4 text-ivory/75" style="--delay:.16s">
                    Những bài viết, video và góc nhìn về cuốn sách đã đồng hành cùng hàng triệu độc giả trên khắp thế giới.
                </p>
            </header>

            <article class="reveal mx-auto mt-10 max-w-4xl" aria-labelledby="featured-video-title">
                <div id="featured-video" class="video-frame"></div>
                <div class="mt-5 flex flex-col gap-1 text-center sm:flex-row sm:items-baseline sm:justify-between sm:text-left">
                    <h3 id="featured-video-title" class="text-lg font-semibold text-ivory md:text-xl"></h3>
                    <p id="featured-video-source" class="text-sm text-champagne/80"></p>
                </div>
            </article>

            <div class="mt-12 text-center">
                <button type="button" data-open-order class="btn btn-primary">
                    Khám phá cuốn sách ngay <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- ===================== ĐỌC THỬ ===================== -->
    <section id="doc-thu" class="section bg-sand" aria-labelledby="preview-title">
        <div class="container-site">
            <header class="mx-auto max-w-3xl text-center">
                <p class="eyebrow eyebrow--light eyebrow--center reveal">Đọc thử</p>
                <h2 id="preview-title" class="section-title reveal mt-3 text-royal" style="--delay:.08s">
                    Lật giở những trang đầu tiên
                </h2>
                <p class="section-lead reveal mx-auto mt-4 text-ink/80" style="--delay:.16s">
                    Kéo góc trang, vuốt, dùng phím mũi tên hoặc nút điều hướng để lật sách. Nhấn <i class="fa-solid fa-up-right-and-down-left-from-center text-sm" aria-hidden="true"></i><span class="sr-only">nút toàn màn hình</span> để đọc rõ hơn.
                </p>
            </header>

            <div id="preview" class="preview reveal mt-10" role="region" aria-roledescription="trình xem trang"
                 aria-label="Đọc thử Nhà Giả Kim" tabindex="0">
                <div class="preview-book">
                    <div id="flipbook" class="flipbook"></div>
                </div>

                <div class="preview-controls mt-6 flex items-center justify-center gap-3 sm:gap-4">
                    <button type="button" class="icon-btn icon-btn--light" data-preview-prev aria-label="Trang trước">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <p class="min-w-[120px] text-center text-sm font-medium text-royal" data-preview-indicator aria-live="polite">1 / 1</p>
                    <button type="button" class="icon-btn icon-btn--light" data-preview-next aria-label="Trang sau">
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="icon-btn icon-btn--light ml-1" data-preview-zoom aria-label="Xem toàn màn hình" title="Toàn màn hình">
                        <i class="fa-solid fa-up-right-and-down-left-from-center" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="mt-10 text-center">
                <button type="button" data-open-order class="btn btn-primary">
                    Mua sách để đọc trọn vẹn <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- ===================== ĐÁNH GIÁ ===================== -->
    <section id="danh-gia" class="section bg-ivory" aria-labelledby="reviews-title">
        <div class="container-site">
            <header class="mx-auto max-w-3xl text-center">
                <p class="eyebrow eyebrow--light eyebrow--center reveal">Đánh giá</p>
                <h2 id="reviews-title" class="section-title reveal mt-3 text-royal" style="--delay:.08s">
                    Độc giả nói gì về Nhà Giả Kim?
                </h2>
            </header>

            <div id="rating-summary" class="card reveal mt-10 p-6 md:p-8"></div>

            <div class="reveal mt-12 md:mt-14">
                <div id="review-list" class="review-slider" aria-label="Danh sách đánh giá"></div>
                <div class="review-controls">
                    <button type="button" class="icon-btn icon-btn--light" data-review-prev aria-label="Đánh giá trước">
                        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="review-dots" data-review-dots></div>
                    <button type="button" class="icon-btn icon-btn--light" data-review-next aria-label="Đánh giá tiếp theo">
                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="mt-12 text-center">
                <button type="button" data-open-order class="btn btn-royal">
                    Đặt mua ngay hôm nay <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </section>
</main>
@section Scripts{
    <script src="js/order.js" asp-append-version="true" defer></script>
}
